def recuperar_contexto(pergunta, kb):\
    p = pergunta.lower()\
    hits = []\
    for item in kb:\
        if item["tema"].lower() in p:\
            hits.append(item["conteudo"])\
    if not hits:\
        # fallback simples: pega 1 conte\'fado \'93mais geral\'94\
        hits = [kb[0]["conteudo"]]\
    return "\\n".join(hits)\
\
