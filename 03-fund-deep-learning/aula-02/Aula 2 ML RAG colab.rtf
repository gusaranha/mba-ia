\fs24 \cf0 \strokec2 Objetivo:
\f1\b0  mostrar a diferen\'e7a entre \'93dado\'94 e \'93informa\'e7\'e3o\'94 e evitar usar dados reais.\
\cf3 \strokec2 Copiar c\'f3digo:\cf0 \strokec2 \
import pandas as pd\
import numpy as np\
\
np.random.seed(42)\
\
tipos = ["Furto", "Roubo", "Amea\'e7a", "Viol\'eancia Dom\'e9stica", "Estelionato", "Tr\'e1fico", "Homic\'eddio (tentativa)"]\
locais = ["Asa Norte", "Asa Sul", "Ceil\'e2ndia", "Taguatinga", "Samambaia", "Planaltina", "Sobradinho"]\
periodos = ["Madrugada", "Manh\'e3", "Tarde", "Noite"]\
\
def gerar_descricao(tipo):\
    base = \{\
        "Furto": "Relato de subtra\'e7\'e3o sem viol\'eancia.",\
        "Roubo": "Relato de subtra\'e7\'e3o com amea\'e7a/viol\'eancia.",\
        "Amea\'e7a": "Relato de amea\'e7a verbal ou por mensagens.",\
        "Viol\'eancia Dom\'e9stica": "Relato de agress\'e3o/amea\'e7a em contexto dom\'e9stico.",\
        "Estelionato": "Relato de golpe por aplicativo, pix ou cart\'e3o.",\
        "Tr\'e1fico": "Relato de poss\'edvel comercializa\'e7\'e3o de entorpecentes.",\
        "Homic\'eddio (tentativa)": "Relato de agress\'e3o grave com risco \'e0 vida."\
    \}\
    return base.get(tipo, "Relato de ocorr\'eancia.")\
\
n = 200\
df = pd.DataFrame(\{\
    "tipo": np.random.choice(tipos, n),\
    "local": np.random.choice(locais, n),\
    "periodo": np.random.choice(periodos, n),\
    "tem_arma": np.random.choice([0,1], n, p=[0.85, 0.15]),\
    "vitima_ferida": np.random.choice([0,1], n, p=[0.75, 0.25]),\
    "historico_reincidencia": np.random.choice([0,1], n, p=[0.7, 0.3])\
\})\
\
df["descricao"] = df["tipo"].apply(gerar_descricao)\
\
# Regra did\'e1tica para gerar "prioridade" (alvo)\
def definir_prioridade(row):\
    score = 0\
    if row["tipo"] in ["Homic\'eddio (tentativa)", "Tr\'e1fico", "Viol\'eancia Dom\'e9stica", "Roubo"]:\
        score += 2\
    if row["tem_arma"] == 1:\
        score += 2\
    if row["vitima_ferida"] == 1:\
        score += 2\
    if row["historico_reincidencia"] == 1:\
        score += 1\
    \
    if score >= 5:\
        return "Alta"\
    elif score >= 3:\
        return "M\'e9dia"\
    else:\
        return "Baixa"\
\
df["prioridade"] = df.apply(definir_prioridade, axis=1)\
\
df.head(10)\
\

